+import { afterEach, expect, it, vi } from 'vitest'
+import { layerSceneV3 } from '../../../core/v3/test-fixtures.js'
+import { createCompositionContent } from '../../../shared/appearance/graph.js'
+import { toCurrentSceneDocument } from '../../../shared/model/current-scene.js'
+import type { ProjectData } from '../../../shared/model/project.js'
+import type { SceneDocument } from '../../../shared/model/scene.js'
+import { createProjectDelta, projectDeltaBytes } from '../../../shared/project/delta.js'
+import { projectContentHash, validateProjectData } from '../../../shared/project/validate.js'
+import { cloneJson } from '../../../shared/validation/json.js'
+import { auditHistoryMessage } from './history-audit-message.js'
+import { auditHistoryRecords, auditHistoryRecordsWithYield, ReconstructionCache, seal, type HistoryGraph, type HistoryVersion } from './history-records.js'
+
+const NOW = '2026-11-12T00:00:00.000Z'
+let sequence = 0
+function graph(owner = 'cooperative-owner'): HistoryGraph {
+  const document = toCurrentSceneDocument({ ...cloneJson(layerSceneV3()), format: 'sceneweave-scene' }) as SceneDocument
+  document.sceneId = owner; document.revision = 0
+  document.assets = {}; document.propDefinitions = {}; document.materials = {}; document.styleThemes = {}; document.activeStyleThemeRef = null
+  const content = createCompositionContent(document, { ids: { nextId: () => `audit-token-${++sequence}` }, clock: { now: () => NOW } })
+  const root = validateProjectData({ format: 'sceneweave-complete-project', schemaVersion: 1, ...content,
+    assets: {}, licenses: {}, licenseBindings: [], authoringSources: {} })
+  const versions: HistoryVersion[] = [], projects: ProjectData[] = []
+  for (let n = 0; n < 4; n++) {
+    const project = cloneJson(root); project.document.revision = n; project.document.title = `version ${n}`
+    projects.push(project)
+    // v2 is an inactive sibling; v3 continues v1. Pins keep the sibling visible.
+    const parent = n === 3 ? versions[1] : n ? versions[0] : null
+    const delta = parent ? createProjectDelta(projects[parent.revision], project) : null
+    versions.push(seal({ format: 'sceneweave-history-version' as const, version: 1 as const, ownerSceneId: owner,
+      id: `${owner}-v${n}`, revision: n, savedAt: NOW, contentHash: projectContentHash(project),
+      parentId: parent?.id ?? null, parentHash: parent?.contentHash ?? null, checkpoint: delta ? null : project, delta,
+      depth: parent ? parent.depth + 1 : 0, chainBytes: parent ? parent.chainBytes + projectDeltaBytes(delta) : 0, automatic: true }))
+  }
+  const active = versions[3], pinned = versions[2]
+  return { head: seal({ format: 'sceneweave-history-head' as const, version: 1 as const, ownerSceneId: owner, status: 'ready' as const,
+    activeVersionId: active.id, savedRevision: active.revision, contentHash: active.contentHash, migration: null }), versions,
+    pins: [seal({ format: 'sceneweave-history-pin' as const, version: 1 as const, id: `${owner}-pin`, ownerSceneId: owner,
+      versionId: pinned.id, lineageId: root.historyIdentity.lineageId, sourceRevision: pinned.revision,
+      name: 'retained sibling', kind: 'named' as const, createdAt: NOW, contentHash: pinned.contentHash })] }
+}
+const synchronous = (g: HistoryGraph) => auditHistoryRecords(g.head.ownerSceneId, g.head, g.versions, g.pins)
+const cooperative = (g: HistoryGraph, schedule: () => Promise<void> = async () => {}) => auditHistoryRecordsWithYield(g.head.ownerSceneId, g.head, g.versions, g.pins, schedule)
+afterEach(() => vi.restoreAllMocks())
+
+it('keeps complete counts, retained siblings and pins identical while yielding through both audit passes', async () => {
+  const g = graph(), schedule = vi.fn(async () => {})
+  expect(await cooperative(g, schedule)).toEqual(synchronous(g))
+  expect(schedule.mock.calls.length).toBeGreaterThan(g.versions.length * 2)
+})
+
+it('owns head, checkpoints, delta preconditions, pins and arrays before a scheduling callback can mutate their originals', async () => {
+  const g = graph(), expected = synchronous(g)
+  let first = true
+  expect(await cooperative(g, async () => {
+    if (!first) return
+    first = false
+    g.head.contentHash = 'f'.repeat(64)
+    g.versions[0].checkpoint!.document.title = 'external mutation'
+    g.versions[1].delta!.changes[0].before = { present: false }
+    g.pins[0].versionId = 'missing'
+    g.versions.length = 0
+  })).toEqual(expected)
+})
+
+it('clears reconstruction state when scheduling rejects after reconstruction, and allows a fresh complete retry', async () => {
+  const g = graph(), remember = vi.spyOn(ReconstructionCache.prototype, 'remember'), clear = vi.spyOn(ReconstructionCache.prototype, 'clear')
+  await expect(cooperative(g, async () => { if (remember.mock.calls.length) throw new Error('cancel scheduling') })).rejects.toThrow('cancel scheduling')
+  expect(clear).toHaveBeenCalledOnce()
+  expect(await cooperative(g)).toEqual(synchronous(g))
+})
+
+it.each(['record hash', 'inactive branch', 'pin target', 'missing parent'] as const)('still rejects %s through the same full audit', async kind => {
+  const g = graph(), branch = g.versions[2]
+  if (kind === 'record hash') branch.recordHash = 'f'.repeat(64)
+  if (kind === 'inactive branch') {
+    branch.delta!.changes[0].after = { present: true, value: 'tampered sibling' }
+    const { recordHash: _hash, ...body } = branch; g.versions[2] = seal(body)
+  }
+  if (kind === 'pin target') { const { recordHash: _hash, ...body } = g.pins[0]; g.pins[0] = seal({ ...body, versionId: 'missing' }) }
+  if (kind === 'missing parent') g.versions.shift()
+  expect(() => synchronous(g)).toThrow()
+  await expect(cooperative(g)).rejects.toThrow()
+})
+
+it.each(['accessor', 'hidden', 'symbol', 'prototype'] as const)('rejects unsafe checkpoint %s before yielding without executing getters', async kind => {
+  const g = graph(), checkpoint = g.versions[0].checkpoint!, getter = vi.fn(), schedule = vi.fn(async () => {})
+  if (kind === 'accessor') Object.defineProperty(checkpoint, 'bad', { enumerable: true, get: getter })
+  if (kind === 'hidden') Object.defineProperty(checkpoint, 'bad', { value: true })
+  if (kind === 'symbol') Object.defineProperty(checkpoint, Symbol('bad'), { value: true, enumerable: true })
+  if (kind === 'prototype') Object.setPrototypeOf(checkpoint, { bad: true })
+  await expect(cooperative(g, schedule)).rejects.toThrow()
+  expect(getter).not.toHaveBeenCalled(); expect(schedule).not.toHaveBeenCalled()
+})
+
+it('cooperatively checks every owner and its retained branches, and observes cancellation between records', async () => {
+  const left = graph('left'), right = graph('right')
+  const message = { kind: 'captured-history' as const, heads: [left.head, right.head], versions: [...left.versions, ...right.versions],
+    pins: [...left.pins, ...right.pins], blocks: [] }
+  expect(await auditHistoryMessage(message, undefined, async () => {})).toEqual({ documentBytes: synchronous(left).documentBytes + synchronous(right).documentBytes })
+  const signal = { aborted: false }, remember = vi.spyOn(ReconstructionCache.prototype, 'remember')
+  await expect(auditHistoryMessage(message, signal, async () => { if (remember.mock.calls.length) signal.aborted = true })).rejects.toMatchObject({ name: 'AbortError' })
+  expect(await auditHistoryMessage(message)).toEqual({ documentBytes: synchronous(left).documentBytes + synchronous(right).documentBytes })
+})
