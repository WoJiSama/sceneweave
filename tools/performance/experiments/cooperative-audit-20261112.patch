+++ b/tests/history-audit-fallback.spec.ts
@@ -0,0 +1,33 @@
+import { expect, test } from '@playwright/test'
+import { createKeyboardProject, keyboardProjectBackup, keyboardResourceHashes, keyboardWorkspaceSaved, openKeyboardPanel, placeKeyboardLamp, selectKeyboardProp } from './keyboard-ux-helpers'
+
+test('production without Worker preserves cold-save content, resources, undo and a second cold open', async ({ page }, info) => {
+  await createKeyboardProject(page, '无后台完整历史保存')
+  await placeKeyboardLamp(page)
+  const before = await keyboardProjectBackup(page, info.outputPath('before.sceneweave'))
+  const owner = before.document.sceneId, [prop] = Object.keys(before.document.props)
+  await page.addInitScript(() => { Reflect.set(globalThis, 'Worker', undefined) })
+  let opens = 0
+  const open = async () => {
+    await page.goto(`./?history-audit-fallback=${++opens}#home`)
+    await page.getByTestId('workspace-home').locator(`[data-project-key="native:${owner}"]`).getByRole('button', { name: '打开', exact: true }).click()
+    await keyboardWorkspaceSaved(page)
+  }
+  await open(); await selectKeyboardProp(page, prop)
+  const angle = (await openKeyboardPanel(page, 'inspector')).getByLabel('物件旋转', { exact: true })
+  await angle.fill('15'); await angle.press('Tab'); await keyboardWorkspaceSaved(page)
+  const saved = await keyboardProjectBackup(page, info.outputPath('saved.sceneweave'))
+  expect(saved.document.props[prop].rotationDeg).toBe(15)
+  expect(saved.document.revision).toBe(before.document.revision + 1)
+  expect(keyboardResourceHashes(saved.hashes)).toEqual(keyboardResourceHashes(before.hashes))
+  await page.getByRole('button', { name: '撤销编辑', exact: true }).click(); await keyboardWorkspaceSaved(page)
+  const undone = await keyboardProjectBackup(page, info.outputPath('undone.sceneweave'))
+  expect(undone.document.props[prop]).toEqual(before.document.props[prop])
+  expect(undone.document.revision).toBe(saved.document.revision + 1)
+  await open()
+  const reopened = await keyboardProjectBackup(page, info.outputPath('reopened.sceneweave'))
+  expect(reopened.document).toEqual(undone.document)
+  expect(reopened.identity).toEqual(undone.identity)
+  expect(reopened.appearance).toEqual(undone.appearance)
+  expect(keyboardResourceHashes(reopened.hashes)).toEqual(keyboardResourceHashes(undone.hashes))
+})
