+/** Synchronous consumers and the Worker drain the same complete audit. */
+export function auditHistoryRecords(owner: string, head: HistoryHead | null, rows: HistoryVersion[], pins: HistoryPin[]): { documentBytes: number } {
+  const steps = historyAuditSteps(owner, head, rows, pins)
+  let step = steps.next()
+  while (!step.done) step = steps.next()
+  return step.value
+}
+
+/** Cooperative page fallback owns all inputs before its first yield. A caller
+ * can change its original graph while the page runs another task, but cannot
+ * change any checkpoint, delta, head or pin consumed by this audit. Project
+ * and delta payloads keep their separate input budgets. No authority survives
+ * completion, failure or a rejected scheduling callback. */
+export async function auditHistoryRecordsWithYield(owner: string, head: HistoryHead | null, rows: HistoryVersion[], pins: HistoryPin[],
+  yieldPage: () => Promise<void>): Promise<{ documentBytes: number }> {
+  const capturedHead = head === null ? null : captureJson(head)
+  const capturedRows = captureRows(rows, INCREMENTAL_HISTORY_LIMITS.versions, input => {
+    exact(input, VERSION_FIELDS)
+    const descriptors = Object.getOwnPropertyDescriptors(input)
+    if (!VERSION_FIELDS.every(key => descriptors[key]?.enumerable && 'value' in descriptors[key])) throw new Error('增量历史含非数据字段。')
+    const values = Object.fromEntries(VERSION_FIELDS.map(key => [key, descriptors[key].value]))
+    const checkpoint = values.checkpoint === null ? null : captureJson(values.checkpoint) as ProjectData
+    const delta = values.delta === null ? null : validateProjectDelta(values.delta)
+    const envelope = captureJson({ ...values, checkpoint: null, delta: null })
+    return { ...envelope, checkpoint, delta } as HistoryVersion
+  })
+  const capturedPins = captureRows(pins, 84, input => captureJson(input) as HistoryPin)
+  const steps = historyAuditSteps(owner, capturedHead, capturedRows, capturedPins)
+  try {
+    await yieldPage()
+    let step = steps.next()
+    while (!step.done) { await yieldPage(); step = steps.next() }
+    return step.value
+  } finally { steps.return({ documentBytes: 0 }) }
+}
+
