+function project(group = false): ProjectData {
+  const source = fixture({ building: true }).project
+  if (!group) return source
+  const content = applyCompositionCommands(candidateContent(source), [{ type: 'createAggregateGroup', group: {
+    id: 'replay-group', floorId: 'blank-floor', parentId: null,
+    frame: { translationMm: { x: 6000, y: 6000 }, quarterTurns: 0 },
+    members: [{ kind: 'prop', id: 'item' }, { kind: 'prop', id: 'other' }], editLocked: false,
+  } }], runtime)
+  return { ...source, ...content }
+}
+function moved(source: ProjectData, x = 4500): ProjectData {
+  const result = cloneJson(source)
+  result.document.props.item.positionMm.x = x; result.document.revision++
+  return result
+}
+
