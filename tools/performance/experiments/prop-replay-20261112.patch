+      expect(following.document.rooms).toBe(result.document.rooms)
+      expect(following.document.props.other).toBe(result.document.props.other)
+      expect(getPropUpdateTransaction(result.document)).toBeUndefined()
+      expect(getPropUpdateCompositionTransaction(result)).toBeUndefined()
+      expect(getProjectLocalTransaction(result)).toBeUndefined()
+      next.document.props.item.positionMm.x = -10000
+      expect(result.document.props.item.positionMm.x).toBe(4500)
+      expect(Object.isFrozen(result.document.props.item.positionMm)).toBe(true)
