@@ -38,8 +40,24 @@ export class StorageAccounting {
         // Dexie supplies a detached old record and dotted-path updates. Preserve it
         // while independently measuring the exact value Dexie will persist.
         if (!this.pending.has(tx)) { this.changed(tx, name, undefined, undefined); return }
-        const next = structuredClone(value)
-        for (const [path, update] of Object.entries(changes)) Dexie.setByKeyPath(next, path, update)
+        const entries = Object.entries(changes), field = CONTENT_PAYLOAD_FIELDS[name]
+        const last = entries.at(-1), replacement = field && last?.[0] === field ? last[1] as ProjectData : undefined
+        // The preceding coordinate hook appends the final complete payload.
+        // Earlier child changes are overwritten by it. Keep this private
+        // immutable endpoint and avoid cloning the old payload just to discard
+        // it. Unknown replacements and other ordering retain the general path.
+        const prepared = replacement && exactEncodedSnapshot(tx.idbtrans, replacement)
+        let next: typeof value
+        if (prepared) {
+          const { [field]: discarded, ...envelope } = value
+          void discarded
+          next = structuredClone(envelope)
+          next[field] = replacement
+          for (const [path, update] of entries) if (path !== field && !path.startsWith(`${field}.`)) Dexie.setByKeyPath(next, path, update)
+        } else {
+          next = structuredClone(value)
+          for (const [path, update] of entries) Dexie.setByKeyPath(next, path, update)
+        }
         this.changed(tx, name, value, next)
       })
     }
