+import 'fake-indexeddb/auto'
+import Dexie from 'dexie'
+import { afterEach, expect, it, vi } from 'vitest'
+import { fixture, runtime, validation } from '../../../application/workspace/test-fixtures.js'
+import { createCompositionContent } from '../../../shared/appearance/graph.js'
+import { ProjectRepository } from './repository.js'
+import { PROJECT_TABLES } from './database.js'
+import { partitionProjectContent } from './content-blocks.js'
+
+const opened: ProjectRepository[] = []
+const make = () => { const repo = new ProjectRepository({ name: `block-batch-${crypto.randomUUID()}`, runtime, validation }); opened.push(repo); return repo }
+afterEach(async () => { vi.restoreAllMocks(); for (const repo of opened.splice(0)) { const name = repo.database.name; repo.close(); await Dexie.delete(name) } })
+function source() {
+  const bundle = fixture(), scene = bundle.project.document
+  for (let index = 0; index < 100; index++) {
+    const id = `batch-${index}`
+    scene.props[id] = { ...structuredClone(scene.props.item), id }
+    scene.entityLayers[id] = scene.entityLayers.item
+  }
+  Object.assign(bundle.project, createCompositionContent(scene, runtime)); return bundle
+}
+
+it('shares pending blocks across concurrent different manifests and keeps returned versions independent', async () => {
+  const repo = make(), input = source(), owner = input.project.document.sceneId
+  await repo.save(input, null)
+  const root = (await repo.database.historyHeads.get(owner))!.activeVersionId
+  const changed = structuredClone(input.project); changed.document.title = 'new title'; changed.document.revision++
+  await repo.save({ project: changed, resources: input.resources }, 0)
+  const native = IDBObjectStore.prototype.get, keys: string[] = []
+  vi.spyOn(IDBObjectStore.prototype, 'get').mockImplementation(function (this: IDBObjectStore, key) {
+    if (this.name === 'projectContentBlocks') keys.push(String(key))
+    return native.call(this, key)
+  })
+  await repo.database.transaction('r', PROJECT_TABLES, async () => {
+    const [current, checkpoint] = await Promise.all([repo.database.projects.get(owner), repo.database.historyVersions.get([owner, root])])
+    expect(current!.project).toEqual(changed); expect(checkpoint!.checkpoint).toEqual(input.project)
+    current!.project.document.props.item.rotationDeg = 90
+    expect(checkpoint!.checkpoint!.document.props.item.rotationDeg).toBe(0)
+    expect((await repo.database.projects.get(owner))!.project).toEqual(changed)
+  })
+  const expected = new Set([...partitionProjectContent(input.project).blocks, ...partitionProjectContent(changed).blocks].map(row => row.sha256))
+  expect(new Set(keys)).toEqual(expected); expect(keys).toHaveLength(expected.size)
+}, 30000)
+
+for (const mode of ['missing', 'corrupt'] as const) it(`rejects a ${mode} block at the end of a batch and rolls back earlier writes`, async () => {
+  const repo = make(), input = source(), owner = input.project.document.sceneId
+  await repo.save(input, null)
+  const partition = partitionProjectContent(input.project), block = partition.blocks.at(-1)!
+  expect(partition.blocks.length).toBeGreaterThan(20)
+  await expect(repo.database.transaction('rw', PROJECT_TABLES, async () => {
+    await repo.database.projects.get(owner) // Fill the first transaction cache.
+    if (mode === 'missing') await repo.database.projectContentBlocks.delete(block.sha256)
+    else { const changed = { sha256: block.sha256, bytes: block.bytes.slice() }; changed.bytes[0] ^= 1; await repo.database.projectContentBlocks.put(changed) }
+    await Promise.all([repo.database.projects.get(owner), repo.database.projects.get(owner)])
+  })).rejects.toThrow(/块|hash|字节/)
+  expect((await repo.load(owner))!.project).toEqual(input.project)
+  expect(await repo.database.projectContentBlocks.get(block.sha256)).toEqual(block)
+}, 30000)
+
+it('rejects a failed native read batch without publishing project or history writes', async () => {
+  const repo = make(), input = source(), owner = input.project.document.sceneId
+  let fail = false
+  repo.database.use({ stack: 'dbcore', name: 'failed-content-batch', level: .5, create: down => ({ ...down, table: name => {
+    const table = down.table(name)
+    return name !== 'projectContentBlocks' ? table : { ...table, getMany: request => fail
+      ? Dexie.Promise.reject(new DOMException('simulated native read failure', 'UnknownError')) : table.getMany(request) }
+  } }) })
+  await repo.save(input, null)
+  const changed = structuredClone(input.project); changed.document.title = 'uncommitted'; changed.document.revision++
+  fail = true
+  await expect(repo.save({ project: changed, resources: input.resources }, 0)).rejects.toThrow(/read failure/)
+  fail = false
+  expect((await repo.load(owner))!.project).toEqual(input.project)
+  expect((await repo.listHistoryVersions(owner)).versions).toHaveLength(1)
+}, 30000)
