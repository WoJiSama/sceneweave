# Copy only when .env.deploy does not exist; preserve existing deployment configuration.
# Set a DNS hostname pointing to this server, or its fixed public IP without scheme/port/path.
SCENEWEAVE_AI_DOMAIN=ai.example.com
# No domain: use the actual public IP and compose.yaml + compose.ip.yaml (Compose >= 2.24.4).
# SCENEWEAVE_AI_DOMAIN=203.0.113.10
# IP mode uses Caddy 2.11.7 TLS-ALPN on 443 only; it preserves existing port 80 services.
# Keep caddy-data and inbound TCP 443 available for automatic 160-hour certificate renewal.
