# Copy to .env.ai.production in the repository root, replace every placeholder, then chmod 600.
# The app container overrides HOST, PORT and DATA_DIR to its private container values.
# Public Pages access needs trusted HTTPS at Caddy; the private container still uses HTTP.
SCENEWEAVE_AI_HOST=0.0.0.0
SCENEWEAVE_AI_PORT=8787
SCENEWEAVE_AI_DATA_DIR=/var/lib/sceneweave-ai
# Exact frontend Origin, unchanged when the backend uses an HTTPS IP; no /sceneweave/ path.
SCENEWEAVE_AI_ALLOWED_ORIGINS=https://wojisama.github.io
SCENEWEAVE_AI_ACCESS_TOKEN=REPLACE_ME
SCENEWEAVE_AI_PROVIDER_BASE_URL=
SCENEWEAVE_AI_PROVIDER_API_KEY=
SCENEWEAVE_AI_PROVIDER_MODEL=
# Optional separate model for requests whose retained conversation contains images.
# Leave unset to use PROVIDER_MODEL for both text and images.
# SCENEWEAVE_AI_PROVIDER_VISION_MODEL=
SCENEWEAVE_AI_PROVIDER_VISION=unverified
# Enable only for a provider requiring opaque reasoning replay in tool history.
# Private continuation stays on the task service and is never streamed to the UI.
SCENEWEAVE_AI_PROVIDER_PRESERVE_REASONING=disabled
# Server-only authoring output budget: default 1024, maximum 8192.
# Includes provider reasoning tokens where the provider counts them.
# SCENEWEAVE_AI_AUTHORING_OUTPUT_TOKENS=4096
