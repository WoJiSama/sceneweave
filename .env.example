# Server-only settings. Copy to .env.ai (ignored); set its permissions to 0600.
SCENEWEAVE_AI_HOST=127.0.0.1
SCENEWEAVE_AI_PORT=8787
SCENEWEAVE_AI_DATA_DIR=local-data/ai
SCENEWEAVE_AI_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
SCENEWEAVE_AI_ACCESS_TOKEN=replace-with-a-random-application-token-of-at-least-32-characters
SCENEWEAVE_AI_PROVIDER_BASE_URL=https://your-provider.example/v1
SCENEWEAVE_AI_PROVIDER_API_KEY=replace-with-your-server-provider-key
SCENEWEAVE_AI_PROVIDER_MODEL=replace-with-a-tested-chat-model
# Frontend public configuration, only when building for a deployed backend:
# VITE_SCENEWEAVE_AI_URL=https://your-backend.example
